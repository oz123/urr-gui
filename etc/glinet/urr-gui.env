# urr-gui environment for /etc/kvmd/user/scripts/S99urr-gui
#
# ADDR                      listen address (default :8080)
# TOKEN                     bearer token for calls to mnas (must match mnas conf)
# MNAS_HOST                 host running mnas (default: mnas)
# MNAS_PORT                 mnas port (default: 80)
# MNAS_SCHEME               http or https (default: http)
# MNAS_PATH_PREFIX          URL path prefix, e.g. /wol when mnas sits
#                           behind an nginx proxy at a sub-path (default: "")
# MNAS_CA_FILE              PEM file to trust mnas's self-signed cert (optional)
# MNAS_INSECURE_SKIP_VERIFY set to "1" to skip TLS verification entirely
#                           instead of using MNAS_CA_FILE (default: false)
# URR_CMD                   binary in PATH that sends the WOL (default: urr)
# URR_ARG                   argument for it (default: mnasx)
# URR_STATE_FILE            where state is persisted (default: /var/lib/urr-gui/state.json)
# BIN                       urr-gui binary (default: /usr/local/bin/urr-gui)

ADDR=:8080
TOKEN=CHANGE_ME
MNAS_HOST=192.168.x.x
MNAS_PORT=443
MNAS_SCHEME=https
MNAS_PATH_PREFIX=/wol
MNAS_CA_FILE=/etc/kvmd/user/mnas-ca.pem
URR_CMD=urr
URR_ARG=mnasx
URR_STATE_FILE=/var/lib/urr-gui/state.json
BIN=/usr/local/bin/urr-gui
